                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_I4)([YEAR](#{Package\Load Data into FactSales\Load Data from stg_SalesOrderHeader, stg_SalesOrderDetail.Outputs[OLE DB Source Output].Columns[OrderDate]}) * 10000 + [MONTH](#{Package\Load Data into FactSales\Load Data from stg_SalesOrderHeader, stg_SalesOrderDetail.Outputs[OLE DB Source Output].Columns[OrderDate]}) * 100 + [DAY](#{Package\Load Data into FactSales\Load Data from stg_SalesOrderHeader, stg_SalesOrderDetail.Outputs[OLE DB Source Output].Columns[OrderDate]}))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_I4)(YEAR(OrderDate) * 10000 + MONTH(OrderDate) * 100 + DAY(OrderDate))</property>
                      </properties>
