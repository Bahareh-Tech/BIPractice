                          description="Derived Column Expression"
                          name="Expression">#{Package\Load Data into FactSales\Load Data from stg_SalesOrderHeader, stg_SalesOrderDetail.Outputs[OLE DB Source Output].Columns[OnlineOrderFlag]} ==  TRUE  ? 2 : 1</property>
                        <property
