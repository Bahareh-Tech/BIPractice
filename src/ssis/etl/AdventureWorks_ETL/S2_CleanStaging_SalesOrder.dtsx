        <SQLTask:SqlTaskData
          SQLTask:Connection="{8650C148-2D74-4165-AF52-A8C698DCAE4F}"
          SQLTask:SqlStatementSource="INSERT INTO stg_ETL_log (PackageName, StageTableName, ValidRows, ErrorRows, LoadDate)&#xA;VALUES (?, 'stg_SalesOrderHeader',&#xA;    (SELECT COUNT(*) FROM stg_SalesOrderHeader),&#xA;    (SELECT COUNT(*) FROM stg_SalesOrderHeader_Error),&#xA;    GETDATE());&#xA;&#xA;INSERT INTO stg_ETL_log (PackageName, StageTableName, ValidRows, ErrorRows, LoadDate)&#xA;VALUES (?, 'stg_SalesOrderDetail',&#xA;    (SELECT COUNT(*) FROM stg_SalesOrderDetail),&#xA;    (SELECT COUNT(*) FROM stg_SalesOrderDetail_Error),&#xA;    GETDATE());" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
