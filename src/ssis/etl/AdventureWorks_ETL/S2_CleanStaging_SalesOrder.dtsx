    <DTS:Executable
      DTS:refId="Package\Remove invalid rows &amp; Fix formatting issues in stg_SalesOrderDetail"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{76dcdd44-1f23-4d2e-ad7a-d710da3b30b0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Remove invalid rows &amp; Fix formatting issues in stg_SalesOrderDetail"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8650C148-2D74-4165-AF52-A8C698DCAE4F}"
          SQLTask:SqlStatementSource="INSERT INTO stg_SalesOrderDetail_Error (SalesOrderID, SalesOrderDetailID, ProductID, OrderQty, UnitPrice, LineTotal, ErrorReason, LoadDate)&#xA;SELECT&#xA;    SalesOrderID, &#xA;    SalesOrderDetailID, &#xA;    ProductID, &#xA;    OrderQty, &#xA;    UnitPrice,&#xA;    LineTotal,&#xA;    'Invalid Data',&#xA;    GETDATE()&#xA;FROM stg_SalesOrderDetail&#xA;WHERE SalesOrderDetailID IS NULL&#xA;    OR SalesOrderID IS NULL&#xA;    OR ProductID IS NULL&#xA;    OR OrderQty IS NULL OR OrderQty &lt;= 0&#xA;    OR UnitPrice IS NULL OR UnitPrice &lt; 0&#xA;    OR UnitPriceDiscount IS NULL&#xA;    OR LineTotal IS NULL OR LineTotal &lt; 0;&#xA;&#xA;DELETE FROM stg_SalesOrderDetail&#xA;WHERE SalesOrderDetailID IS NULL&#xA;    OR SalesOrderID IS NULL&#xA;    OR ProductID IS NULL&#xA;    OR OrderQty IS NULL OR OrderQty &lt;= 0&#xA;    OR UnitPrice IS NULL OR UnitPrice &lt; 0&#xA;    OR UnitPriceDiscount IS NULL&#xA;    OR LineTotal IS NULL OR LineTotal &lt; 0;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Remove invalid rows &amp; Fix formatting issues in stg_SalesOrderHeader"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FE182953-0B59-4409-A8BD-1432E1326013}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Remove invalid rows &amp; Fix formatting issues in stg_SalesOrderHeader"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8650C148-2D74-4165-AF52-A8C698DCAE4F}"
          SQLTask:SqlStatementSource="INSERT INTO stg_SalesOrderHeader_Error (SalesOrderID, OrderDate, DueDate, ShipDate, OnlineOrderFlag, CustomerID, TerritoryID, ErrorReason, LoadDate)&#xA;SELECT&#xA;    SalesOrderID,&#xA;    OrderDate,&#xA;    DueDate,&#xA;    ShipDate,&#xA;    OnlineOrderFlag,&#xA;    CustomerID,&#xA;    TerritoryID,&#xA;    'Invalid data', &#xA;    GETDATE()&#xA;FROM stg_SalesOrderHeader&#xA;WHERE SalesOrderID IS NULL&#xA;    OR OrderDate IS NULL&#xA;    OR CustomerID IS NULL&#xA;    OR TerritoryID IS NULL&#xA;    OR OnlineOrderFlag IS NULL&#xA;    OR ShipDate &lt; OrderDate&#xA;    OR OrderDate &lt; '2000-01-01'&#xA;    OR OrderDate &gt; GETDATE();&#xA;&#xA;DELETE FROM stg_SalesOrderHeader&#xA;WHERE SalesOrderID IS NULL&#xA;    OR OrderDate IS NULL&#xA;    OR CustomerID IS NULL&#xA;    OR TerritoryID IS NULL&#xA;    OR OnlineOrderFlag IS NULL&#xA;    OR ShipDate &lt; OrderDate&#xA;    OR OrderDate &lt; '2000-01-01'&#xA;    OR OrderDate &gt; GETDATE();" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Remove orphan Detail rows whose had invalid Header parent"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EC77D405-0C2D-4C11-BBCF-2A7034D7869F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Remove orphan Detail rows whose had invalid Header parent"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8650C148-2D74-4165-AF52-A8C698DCAE4F}"
          SQLTask:SqlStatementSource="INSERT INTO stg_SalesOrderDetail_Error (SalesOrderID, SalesOrderDetailID, ProductID, OrderQty, UnitPrice, LineTotal, ErrorReason, LoadDate)&#xA;SELECT&#xA;    d.SalesOrderID,&#xA;    d.SalesOrderDetailID,&#xA;    d.ProductID,&#xA;    d.OrderQty,&#xA;    d.UnitPrice,&#xA;    d.LineTotal,&#xA;    'Orphan: SalesOrderID not found in stg_SalesOrderHeader',&#xA;    GETDATE()&#xA;FROM stg_SalesOrderDetail d&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM stg_SalesOrderHeader h&#xA;    WHERE h.SalesOrderID = d.SalesOrderID&#xA;);&#xA;&#xA;DELETE FROM stg_SalesOrderDetail&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM stg_SalesOrderHeader h&#xA;    WHERE h.SalesOrderID = stg_SalesOrderDetail.SalesOrderID&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
