          SQLTask:Connection="{8650C148-2D74-4165-AF52-A8C698DCAE4F}"
          SQLTask:SqlStatementSource="INSERT INTO stg_SalesOrderHeader_Error (SalesOrderID, OrderDate, DueDate, ShipDate, OnlineOrderFlag, CustomerID, TerritoryID, ErrorReason, LoadDate)&#xA;SELECT&#xA;    SalesOrderID,&#xA;    OrderDate,&#xA;    DueDate,&#xA;    ShipDate,&#xA;    OnlineOrderFlag,&#xA;    CustomerID,&#xA;    TerritoryID,&#xA;    'Invalid data', &#xA;    GETDATE()&#xA;FROM stg_SalesOrderHeader&#xA;WHERE SalesOrderID IS NULL&#xA;    OR OrderDate IS NULL&#xA;    OR CustomerID IS NULL&#xA;    OR TerritoryID IS NULL&#xA;    OR OnlineOrderFlag IS NULL&#xA;    OR ShipDate &lt; OrderDate&#xA;    OR OrderDate &lt; '2000-01-01'&#xA;    OR OrderDate &gt; GETDATE();&#xA;&#xA;&#xA;DELETE FROM stg_SalesOrderHeader&#xA;WHERE SalesOrderID IS NULL&#xA;    OR OrderDate IS NULL&#xA;    OR CustomerID IS NULL&#xA;    OR TerritoryID IS NULL&#xA;    OR OnlineOrderFlag IS NULL&#xA;    OR ShipDate &lt; OrderDate&#xA;    OR OrderDate &lt; '2000-01-01'&#xA;    OR OrderDate &gt; GETDATE();&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
