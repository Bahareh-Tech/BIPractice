        <AnnotationLayout
          Text="Stage 2 - Clean stg_Person&#xA;Reads from stg_Person (loaded by S1_LoadStaging_Person).&#xA;Removes rows that would break the warehouse load:&#xA;  - NULL BusinessEntityID (join key to stg_Customer.PersonID in Stage 3)&#xA;  - NULL, empty, or whitespace-only FirstName or LastName&#xA;    (combined into CustomerName NOT NULL in DimCustomer)&#xA;Rejected rows are copied to stg_Person_Error before deletion.&#xA;Trims FirstName and LastName for consistent name values in DimCustomer."
          ParentId="Package"
          FontInfo="{assembly:Null}"
          Size="428.8,152"
          Id="8fb4738f-43b0-431c-9abf-95eeac554d2c"
          TopLeft="12.9714285258128,268.411764470609" />
        <AnnotationLayout
          Text="Validates and cleans stg_Person.&#xA;1. Copies invalid rows to stg_Person_Error with reason&#xA;2. Deletes invalid rows from stg_Person&#xA;3. Trims FirstName and LastName"
          ParentId="Package"
          FontInfo="{assembly:Null}"
          Size="312.8,88"
          Id="6ce1dd9d-2e63-4077-9c66-fa4ae88a6c71"
