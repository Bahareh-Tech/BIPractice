                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    C.CustomerID,
    C.StoreID,
    C.PersonID,
    P.FirstName,
    P.LastName,
    S.Name AS StoreName,
    C.RowHash
FROM stg_Customer AS C
LEFT JOIN stg_Person AS P ON C.PersonID  = P.BusinessEntityID
LEFT JOIN stg_Store  AS S ON C.StoreID   = S.BusinessEntityID</property>
