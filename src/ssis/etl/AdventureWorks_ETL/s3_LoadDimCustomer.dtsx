        <AnnotationLayout
          Text="Source: LEFT JOIN stg_Customer + stg_Person + stg_Store&#xA;CustomerID, PersonID, FirstName, LastName, StoreName, RowHash.&#xA;Note: LEFT JOINs — NULL PersonID or StoreID is valid business data, not an error."
          ParentId="Package\Load Data into DimCustomer"
          FontInfo="{assembly:Null}"
          Size="430.4,88"
          Id="a1b2c3d4-1001-1002-1003-200000000004"
          TopLeft="558.163265004189,26.8907563140118" />
        <AnnotationLayout
          Text="Derived Column: CustomerName + CustomerType&#xA;Individual (PersonID not null): CustomerName = FirstName + ' ' + LastName, CustomerType = 'Individual'.&#xA;Store (PersonID null): CustomerName = StoreName, CustomerType = 'Store'."
          ParentId="Package\Load Data into DimCustomer"
          FontInfo="{assembly:Null}"
          Size="430.4,104"
          Id="a1b2c3d4-1001-1002-1003-200000000005"
          TopLeft="558.163265004189,110.890756314012" />
        <AnnotationLayout
          Text="Data Conversion: Trims CustomerName + CustomerType to warehouse NVARCHAR column widths."
          ParentId="Package\Load Data into DimCustomer"
          FontInfo="{assembly:Null}"
          Size="430.4,56"
          Id="a1b2c3d4-1001-1002-1003-200000000006"
          TopLeft="558.163265004189,194.890756314012" />
        <AnnotationLayout
          Text="SCD Check Lookup: SELECT CustomerIDBK, CustomerKey, DimRowHash FROM DimCustomer&#xA;Match (customer exists) -&gt; Conditional Split for SCD Type 1 check.&#xA;No Match (new customer) -&gt; INSERT into DimCustomer."
          ParentId="Package\Load Data into DimCustomer"
          FontInfo="{assembly:Null}"
          Size="430.4,88"
          Id="a1b2c3d4-1001-1002-1003-200000000007"
          TopLeft="558.163265004189,246.890756314012" />
        <AnnotationLayout
          Text="Conditional Split (SCD Type 1):&#xA;RowHash != DimRowHash -&gt; changed -&gt; Update DimCustomer (OLE DB Command).&#xA;RowHash == DimRowHash -&gt; no change -&gt; No Change to DimCustomer (discard)."
          ParentId="Package\Load Data into DimCustomer"
          FontInfo="{assembly:Null}"
          Size="430.4,104"
          Id="a1b2c3d4-1001-1002-1003-200000000008"
          TopLeft="558.163265004189,330.890756314012" />
        <AnnotationLayout
          Text="INSERT: New customer row (No Match from SCD Lookup).&#xA;Maps CustomerID-&gt;CustomerIDBK, CustomerName, CustomerType, RowHash-&gt;DimRowHash.&#xA;Do NOT map CustomerKey (IDENTITY column)."
          ParentId="Package\Load Data into DimCustomer"
          FontInfo="{assembly:Null}"
          Size="430.4,88"
          Id="a1b2c3d4-1001-1002-1003-200000000009"
          TopLeft="558.163265004189,402.890756314012" />
        <AnnotationLayout
          Text="UPDATE: OLE DB Command — SET CustomerName=?, CustomerType=?, DimRowHash=?&#xA;WHERE CustomerKey=? (surrogate key, last parameter)."
