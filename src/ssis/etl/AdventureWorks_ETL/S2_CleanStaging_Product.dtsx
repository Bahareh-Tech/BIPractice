    <DTS:Executable
      DTS:refId="Package\Remove invalid rows &amp; Fix formatting issues in stg_Product"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2F6847D8-C151-4D67-8DA8-1AB1B998352D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Remove invalid rows &amp; Fix formatting issues in stg_Product"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8650C148-2D74-4165-AF52-A8C698DCAE4F}"
          SQLTask:SqlStatementSource="INSERT INTO stg_Product_Error (ProductID, Name, ListPrice, ErrorReason, LoadDate)&#xA;SELECT &#xA;    ProductID, &#xA;    Name, &#xA;    ListPrice, &#xA;    'NULL key or negative price', &#xA;    GETDATE()&#xA;FROM stg_Product&#xA;WHERE ProductID IS NULL &#xA;    OR Name IS NULL &#xA;    OR ListPrice &lt; 0;&#xA;&#xA;DELETE FROM stg_Product &#xA;WHERE ProductID IS NULL &#xA;    OR Name IS NULL &#xA;    OR ListPrice &lt; 0;&#xA;&#xA;UPDATE stg_Product &#xA;SET Name = TRIM(Name), &#xA;    ProductNumber = TRIM(ProductNumber);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
