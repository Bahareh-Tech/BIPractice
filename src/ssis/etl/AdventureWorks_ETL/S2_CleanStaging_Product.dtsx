        <AnnotationLayout
          Text="Stage 2 - Clean stg_Product&#xA;Reads from stg_Product (loaded by S1_LoadStaging_Product).&#xA;Removes rows that would break the warehouse load:&#xA;  - NULL ProductID (business key)&#xA;  - NULL or empty Name (maps to ProductName NOT NULL in DimProduct)&#xA;  - Negative ListPrice (maps to ListPrice NOT NULL in DimProduct)&#xA;Rejected rows are copied to stg_Product_Error before deletion.&#xA;Trims whitespace from Name and ProductNumber for reliable joins in Stage 3."
          ParentId="Package"
          FontInfo="{assembly:Null}"
          Size="440,152"
          Id="381da9f3-74cb-40e1-8744-9701d453fc3e"
          TopLeft="35.0000000745051,279.423529294462" />
        <AnnotationLayout
          Text="Validates and cleans stg_Product.&#xA;1. Copies invalid rows to stg_Product_Error with reason&#xA;2. Deletes invalid rows from stg_Product&#xA;3. Trims Name and ProductNumber"
          ParentId="Package"
          FontInfo="{assembly:Null}"
          Size="318.4,88"
          Id="d0fa730d-6f8b-4e05-8417-7c559ef5ea03"
          TopLeft="451.371429079284,48.8823529123536" />
        <AnnotationLayout
          Text="Logs final row counts to stg_ETL_log.&#xA;ValidRows = rows remaining in stg_Product after cleaning.&#xA;ErrorRows = rows in stg_Product_Error.&#xA;Both counts together should equal the S1 row count."
          ParentId="Package"
          FontInfo="{assembly:Null}"
          Size="335.2,88"
          Id="c9b6a9c9-3984-4a3a-a19e-f726532989d7"
          TopLeft="449.742857807327,161.917646928116" />
